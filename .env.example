# ============================================================================
# UPA (Universal Parser Automatization) — пример локальной конфигурации
# Скопируйте файл в .env и при необходимости измените значения.
# ============================================================================

# --- Приложение -------------------------------------------------------------
UPA_APP_NAME=UPA
UPA_ENV=dev
UPA_DEBUG=true
UPA_LOG_LEVEL=INFO
UPA_LOG_JSON=false

# --- HTTP API ---------------------------------------------------------------
UPA_HOST=127.0.0.1
UPA_PORT=8000
# Через запятую. Для локального использования достаточно дев-адреса Vite.
UPA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Хранилище --------------------------------------------------------------
# По умолчанию data/upa.db относительно корня репозитория.
UPA_DATABASE_URL=sqlite+aiosqlite:///./data/upa.db

# --- Браузер (используется на Этапе 1) --------------------------------------
UPA_BROWSER_HEADLESS=true
UPA_BROWSER_TIMEOUT_MS=30000
UPA_BROWSER_LOCALE=ru-RU
# Ограничение размера обрезанного DOM, который уходит в модель (в токенах).
UPA_DOM_MAX_TOKENS=24000

# --- LLM --------------------------------------------------------------------
# Провайдер: ollama | openai_compatible | none
UPA_LLM_PROVIDER=ollama
UPA_OLLAMA_BASE_URL=http://127.0.0.1:11434
UPA_OLLAMA_MODEL=qwen2.5:7b
# Облачный фолбэк включается только явным согласием пользователя.
UPA_LLM_CLOUD_FALLBACK=false
UPA_LLM_CLOUD_BASE_URL=
UPA_LLM_CLOUD_API_KEY=
UPA_LLM_CLOUD_MODEL=
# Таймаут одного запроса к модели, секунды.
UPA_LLM_TIMEOUT_S=180

# --- Хранение артефактов ----------------------------------------------------
UPA_ARTIFACTS_RETENTION_DAYS=30
